# Copie este arquivo para um novo arquivo chamado ".env" e preencha os valores.
# O arquivo .env NUNCA deve ser enviado pro GitHub (ele já está no .gitignore).

# Chave secreta usada para assinar os cookies de sessão (login).
# Gere uma sua rodando este comando no terminal e colando o resultado aqui:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=148230b16574ff2a2b514819f8ae8354405152f65955c141c2bb14969b515242

# Deixe True apenas no SEU computador, enquanto está desenvolvendo.
# Antes de publicar o site de verdade, mude para False (ou apague a linha).
FLASK_DEBUG=True

# Deixe False até o site estar publicado com HTTPS configurado.
# Depois de publicado com HTTPS, mude para True.
USE_HTTPS=False
